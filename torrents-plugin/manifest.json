{
  "id": "potok-torrents",
  "name": "Поиск торрентов",
  "version": "1.0.3",
  "description": "Поиск и стриминг торрент-раздач через native SearchEngine и TorrentGo",
  "author": "author",
  "entrypoint": "index.js",
  "permissions": [
    "storage",
    "http-proxy",
    "ui-notifications"
  ],
  "slots": [
    {
      "id": "torrents-media-actions",
      "slotName": "media-actions",
      "title": "Смотреть"
    },
    {
      "id": "torrents-sidebar-status",
      "slotName": "sidebar-status",
      "title": "Статус Торрентов"
    }
  ],
  "config": {
    "torrentGoURL": {
      "type": "string",
      "default": "https://torrent.potok.rip",
      "label": "Адрес TorrentGo"
    },
    "searchEngineURL": {
      "type": "string",
      "default": "https://search.potok.rip",
      "label": "Адрес SearchEngine"
    }
  }
}
