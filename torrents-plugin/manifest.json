{
  "id": "potok-torrents",
  "name": "potok-torrents:manifest.name",
  "category": "sources",
  "entrypoint": "index.js",
  "permissions": [
    "storage",
    "http-proxy",
    "ui-notifications",
    "custom-css",
    "navigation",
    "slots",
    "streams",
    "timers"
  ],
  "slots": [
    {
      "id": "torrents-media-actions",
      "slotName": "media-actions",
      "title": "potok-torrents:manifest.watch"
    },
    {
      "id": "torrents-sidebar-status",
      "slotName": "sidebar-status",
      "title": "potok-torrents:manifest.statusTitle"
    }
  ],
  "config": {
    "searchSource": {
      "type": "select",
      "default": "jacred",
      "options": [
        { "label": "potok-torrents:settings.searchSourcePotok", "value": "potok" },
        { "label": "potok-torrents:settings.searchSourceJacred", "value": "jacred" }
      ],
      "label": "potok-torrents:settings.searchSource",
      "layoutRow": "search-source"
    },
    "jacredURL": {
      "type": "string",
      "default": "https://jacred.stream",
      "label": "potok-torrents:config.jacredUrl",
      "layoutRow": "search-source"
    },
    "searchEngineURL": {
      "type": "string",
      "default": "",
      "label": "potok-torrents:config.searchEngineUrl",
      "layoutRow": "search-source"
    },
    "torrentGoURL": {
      "type": "string",
      "default": "https://torrent.potok.rip",
      "label": "potok-torrents:config.torrentGoUrl"
    },
    "jacredApiKey": {
      "type": "string",
      "default": "",
      "label": "potok-torrents:config.jacredApiKey"
    }
  }
}
