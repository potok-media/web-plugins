{
  "id": "potok-torrents",
  "name": "potok-torrents:manifest.name",
  "category": "sources",
  "entrypoint": "index.js",
  "permissions": [
    "storage",
    "http-proxy",
    "ui-notifications"
  ],
  "slots": [
    {
      "id": "torrents-media-actions",
      "slotName": "media-actions",
      "title": "potok-torrents:manifest.watch"
    },
    {
      "id": "torrents-sidebar-status",
      "slotName": "sidebar-status",
      "title": "potok-torrents:manifest.statusTitle"
    }
  ],
  "config": [
    {
      "id": "searchEngine",
      "label": "potok-torrents:config.name-category-searchEngine",
      "data": {
        "searchEngineURL": {
          "type": "string",
          "default": "https://search.potok.rip",
          "label": "potok-torrents:config.searchEngineUrl"
        },
        "searchEngineApiKey": {
          "type": "string",
          "default": "",
          "label": "potok-torrents:config.searchEngineApiKey"
        }
      }
    },
    {
      "id": "torrentGo",
      "label": "potok-torrents:config.name-category-torrentGo",
      "data": {
        "torrentGoURL": {
          "type": "string",
          "default": "https://torrent.potok.rip",
          "label": "potok-torrents:config.torrentGoUrl"
        }
      }
    },
    {
      "id": "dedup",
      "label": "potok-torrents:config.name-category-dedup",
      "data": {
        "mergeDuplicates": {
          "type": "boolean",
          "default": true,
          "label": "potok-torrents:config.mergeDuplicates"
        },
        "mergeNumDuplicates": {
          "type": "boolean",
          "default": true,
          "label": "potok-torrents:config.mergeNumDuplicates"
        }
      }
    },
    {
      "id": "cache",
      "label": "potok-torrents:config.name-category-cache",
      "data": {
        "cacheEnable": {
          "type": "boolean",
          "default": true,
          "label": "potok-torrents:config.cacheEnable"
        },
        "cacheExpiry": {
          "type": "number",
          "default": 15,
          "label": "potok-torrents:config.cacheExpiry"
        },
        "cacheAuthExpiry": {
          "type": "number",
          "default": 1,
          "label": "potok-torrents:config.cacheAuthExpiry"
        }
      }
    },
    {
      "id": "refresh",
      "label": "potok-torrents:config.name-category-refresh",
      "data": {
        "refreshEnable": {
          "type": "boolean",
          "default": true,
          "label": "potok-torrents:config.refreshEnable"
        },
        "refreshTimeout": {
          "type": "number",
          "default": 1440,
          "label": "potok-torrents:config.refreshTimeout"
        },
        "refreshOlderThanMin": {
          "type": "number",
          "default": 180,
          "label": "potok-torrents:config.refreshOlderThanMin"
        },
        "refreshLimit": {
          "type": "number",
          "default": 50,
          "label": "potok-torrents:config.refreshLimit"
        }
      }
    },
    {
      "id": "ffprobe",
      "label": "potok-torrents:config.name-category-ffprobe",
      "data": {
        "ffprobeEnable": {
          "type": "boolean",
          "default": true,
          "label": "potok-torrents:config.ffprobeEnable"
        },
        "ffprobeTimeout": {
          "type": "number",
          "default": 60,
          "label": "potok-torrents:config.ffprobeTimeout"
        },
        "ffprobeTsUri": {
          "type": "string",
          "default": "",
          "label": "potok-torrents:config.ffprobeTsUri"
        },
        "ffprobeBatchSize": {
          "type": "number",
          "default": 20,
          "label": "potok-torrents:config.ffprobeBatchSize"
        },
        "ffprobeAttempts": {
          "type": "number",
          "default": 3,
          "label": "potok-torrents:config.ffprobeAttempts"
        },
        "ffprobeLogin": {
          "type": "string",
          "default": "",
          "label": "potok-torrents:config.ffprobeLogin"
        },
        "ffprobePassword": {
          "type": "string",
          "default": "",
          "label": "potok-torrents:config.ffprobePassword"
        }
      }
    },
    {
      "id": "proxy",
      "label": "potok-torrents:config.name-category-proxy",
      "data": {
        "proxyBypassOnLocal": {
          "type": "boolean",
          "default": false,
          "label": "potok-torrents:config.proxyBypassOnLocal"
        },
        "proxyUrl": {
          "type": "string",
          "default": "",
          "label": "potok-torrents:config.proxyUrl"
        },
        "proxyUsername": {
          "type": "string",
          "default": "",
          "label": "potok-torrents:config.proxyUsername"
        },
        "proxyPassword": {
          "type": "string",
          "default": "",
          "label": "potok-torrents:config.proxyPassword"
        }
      }
    },
    {
      "id": "rutracker",
      "label": "potok-torrents:config.name-category-rutracker",
      "data": {
        "rutrackerEnableSearch": {
          "type": "boolean",
          "default": true,
          "label": "potok-torrents:config.rutrackerEnableSearch"
        },
        "rutrackerPopularEnable": {
          "type": "boolean",
          "default": false,
          "label": "potok-torrents:config.rutrackerPopularEnable"
        },
        "rutrackerPopularTimeout": {
          "type": "number",
          "default": 600,
          "label": "potok-torrents:config.rutrackerPopularTimeout"
        },
        "rutrackerPopularMaxPages": {
          "type": "number",
          "default": 3,
          "label": "potok-torrents:config.rutrackerPopularMaxPages"
        },
        "rutrackerPopularCategories": {
          "type": "string",
          "default": "1106, 1105, 2491, 1389",
          "label": "potok-torrents:config.rutrackerPopularCategories"
        },
        "rutrackerLogin": {
          "type": "string",
          "default": "",
          "label": "potok-torrents:config.rutrackerLogin"
        },
        "rutrackerPassword": {
          "type": "string",
          "default": "",
          "label": "potok-torrents:config.rutrackerPassword"
        }
      }
    },
    {
      "id": "animelayer",
      "label": "potok-torrents:config.name-category-animelayer",
      "data": {
        "animelayerEnableSearch": {
          "type": "boolean",
          "default": true,
          "label": "potok-torrents:config.animelayerEnableSearch"
        },
        "animelayerLogin": {
          "type": "string",
          "default": "",
          "label": "potok-torrents:config.animelayerLogin"
        },
        "animelayerPassword": {
          "type": "string",
          "default": "",
          "label": "potok-torrents:config.animelayerPassword"
        }
      }
    },
    {
      "id": "kinozal",
      "label": "potok-torrents:config.name-category-kinozal",
      "data": {
        "kinozalEnableSearch": {
          "type": "boolean",
          "default": true,
          "label": "potok-torrents:config.kinozalEnableSearch"
        },
        "kinozalLogin": {
          "type": "string",
          "default": "",
          "label": "potok-torrents:config.kinozalLogin"
        },
        "kinozalPassword": {
          "type": "string",
          "default": "",
          "label": "potok-torrents:config.kinozalPassword"
        }
      }
    },
    {
      "id": "otherTrackers",
      "label": "potok-torrents:config.name-category-otherTrackers",
      "data": {
        "nnmclubEnableSearch": {
          "type": "boolean",
          "default": true,
          "label": "potok-torrents:config.nnmclubEnableSearch"
        },
        "rutorEnableSearch": {
          "type": "boolean",
          "default": true,
          "label": "potok-torrents:config.rutorEnableSearch"
        },
        "anilibertyEnableSearch": {
          "type": "boolean",
          "default": true,
          "label": "potok-torrents:config.anilibertyEnableSearch"
        },
        "megapeerEnableSearch": {
          "type": "boolean",
          "default": true,
          "label": "potok-torrents:config.megapeerEnableSearch"
        }
      }
    }
  ]
}