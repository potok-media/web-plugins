{
  "id": "potok-torrents",
  "name": "potok-torrents:manifest.name",
  "category": "sources",
  "entrypoint": "index.js",
  "permissions": [
    "storage",
    "http-proxy",
    "ui-notifications"
  ],
  "slots": [
    {
      "id": "torrents-media-actions",
      "slotName": "media-actions",
      "title": "potok-torrents:manifest.watch"
    },
    {
      "id": "torrents-sidebar-status",
      "slotName": "sidebar-status",
      "title": "potok-torrents:manifest.statusTitle"
    }
  ],
  "config": {
    "torrentGoURL": {
      "type": "string",
      "default": "https://torrent.potok.rip",
      "label": "potok-torrents:config.torrentGoUrl"
    },
    "searchEngineURL": {
      "type": "string",
      "default": "https://search.potok.rip",
      "label": "potok-torrents:config.searchEngineUrl"
    },
    "enableAiParsing": {
      "type": "boolean",
      "default": false,
      "label": "potok-torrents:config.enableAi"
    },
    "aiApiKey": {
      "type": "string",
      "default": "",
      "label": "potok-torrents:config.aiApiKey",
      "descriptionHtml": "potok-torrents:config.aiApiKeyHint",
      "layoutRow": "aiCredentials",
      "dependsOn": "enableAiParsing"
    },
    "aiProvider": {
      "type": "select",
      "default": "groq",
      "options": [
        { "value": "groq", "label": "Groq (Free)" },
        { "value": "openai", "label": "OpenAI" },
        { "value": "custom", "label": "Custom (OpenAI-compatible)" }
      ],
      "label": "potok-torrents:config.aiProvider",
      "layoutRow": "aiCredentials",
      "dependsOn": "enableAiParsing"
    },
    "aiModelName": {
      "type": "string",
      "default": "llama-3.1-8b-instant",
      "label": "potok-torrents:config.aiModel",
      "dependsOn": "enableAiParsing"
    },
    "aiCustomEndpoint": {
      "type": "string",
      "default": "https://api.groq.com/openai/v1",
      "label": "potok-torrents:config.aiEndpoint",
      "dependsOn": "enableAiParsing"
    },
    "aiProviderNotice": {
      "type": "notice",
      "default": "",
      "dependsOn": "enableAiParsing"
    }
  }
}
