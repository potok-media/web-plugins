{
  "id": "potok-online-balancer",
  "name": "Модульные Онлайн Источники",
  "version": "1.0.0",
  "description": "Онлайн источники",
  "author": "author",
  "entrypoint": "index.js",
  "permissions": [
    "storage",
    "http-proxy",
    "ui-notifications"
  ],
  "slots": [
    {
      "slotName": "settings-tabs",
      "id": "online-balancer-settings",
      "title": "Онлайн балансеры"
    }
  ],
  "config": {
    "videodb_api_url": {
      "type": "string",
      "default": "https://videodb.cloud",
      "label": "Адрес VideoDB Cloud API"
    },
    "enable_4k": {
      "type": "boolean",
      "default": true,
      "label": "Поиск 4К источников"
    }
  }
}
